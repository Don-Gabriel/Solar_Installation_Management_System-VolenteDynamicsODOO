{
  "name": "sunpower-operations", "private": true, "version": "0.1.0", "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "db:local": "node scripts/local-database.mjs",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env db/seeds/demo.ts",
    "start": "node --env-file=.env apps/api/dist/apps/api/src/server.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {"node": ">=24"},
  "devDependencies": {"typescript": "latest", "tsx": "latest", "concurrently": "latest", "vitest": "latest", "@playwright/test": "latest", "@types/node": "latest", "@types/pg": "latest"}
}
